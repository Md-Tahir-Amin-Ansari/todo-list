{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "server/server.ts",
    "server/routes/todoRoutes.ts",
    "server/routes/authRoutes.ts",
    "server/middleware/middleware.ts",
    "server/types.ts",
    "server/schema/schema.ts",
    "server/db/database.ts",
    "server/repositories/todoRepository.ts",
    "server/repositories/userRepository.ts",
    "server/repositories/sessionRepository.ts"
  ],
  "entryPointStrategy": "resolve",
  "out": "docs/api",
  "name": "Doable - Backend API Reference",
  "readme": "README.md",
  "cleanOutputDir": true,
  "gitRevision": "main",
  "blockTags": [
    "@brief",
    "@details",
    "@note",
    "@throws",
    "@params"
  ]
}